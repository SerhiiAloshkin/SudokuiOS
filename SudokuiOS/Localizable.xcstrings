    "19" : {

    },
    "A number dims once you've placed it 9 times on the board. Turn off \"Disable Completed Digits\" in Settings to keep using it anyway." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number dims once you've placed it 9 times on the board. Turn off \"Disable Completed Digits\" in Settings to keep using it anyway."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chiffre s'estompe une fois placé 9 fois sur la grille. Désactivez « Désactiver les chiffres complétés » dans les réglages pour continuer à l'utiliser."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число тьмяніє, коли ви розмістили його 9 разів на дошці. Вимкніть «Вимикати завершені цифри» в налаштуваннях, щоб продовжити ним користуватися."
          }
        }
      }
    },
