    },
    "Adjacent cells (including diagonals) cannot contain the same number." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjacent cells (including diagonals) cannot contain the same number."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cellules adjacentes (y compris en diagonale) ne peuvent pas contenir le même chiffre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сусідні клітинки (включно з діагоналями) не можуть містити однакове число."
          }
        }
      }
    },
    "Adjacent cells cannot contain consecutive numbers (e.g. 4 & 5)." : {
      "localizations" : {
