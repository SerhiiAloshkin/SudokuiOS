{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\n\n\n---------------------------------\nTechnical details for support:\nApp Version: %@ (%@)\niOS Version: %@\nDevice Model: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n\n---------------------------------\nTechnical details for support:\nApp Version: %1$@ (%2$@)\niOS Version: %3$@\nDevice Model: %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n\n---------------------------------\nDétails techniques pour l'assistance :\nVersion de l'app : %1$@ (%2$@)\nVersion iOS : %3$@\nModèle d'appareil : %4$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n\n---------------------------------\nТехнічні дані для підтримки:\nВерсія програми: %1$@ (%2$@)\nВерсія iOS: %3$@\nМодель пристрою: %4$@"
          }
        }
      }
    },
    " • " : {

    },
    "-" : {

    },
    "\"%@\" will be permanently deleted. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" will be permanently deleted. This cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera définitivement supprimé. Cette action est irréversible."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» буде остаточно видалено. Цю дію неможливо скасувати."
          }
        }
      }
    },
    "\"19\" Button" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"19\" Button"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouton « 19 »"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «19»"
          }
        }
      }
    },
    "(Detailed Mode) Highlights the selected cell's row, column, and 3x3 box, showing all rules affecting that spot." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Detailed Mode) Highlights the selected cell's row, column, and 3x3 box, showing all rules affecting that spot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Mode Détaillé) Met en surbrillance la ligne, la colonne et le bloc 3x3 de la cellule sélectionnée, montrant toutes les règles affectant cet emplacement."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Детальний режим) Підсвічує рядок, стовпець і блок 3x3 вибраної клітинки, показуючи всі правила, що впливають на це місце."
          }
        }
      }
    },
    "(Detailed Mode) Visually reveals all valid empty spots where your selected number could be placed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Detailed Mode) Visually reveals all valid empty spots where your selected number could be placed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Mode Détaillé) Révèle visuellement tous les emplacements vides valides où votre chiffre sélectionné pourrait être placé."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Детальний режим) Візуально показує всі дійсні порожні місця, куди можна поставити вибране число."
          }
        }
      }
    },
