    "If there is NO dot between two cells, their difference CANNOT be 1 and their ratio CANNOT be 2:1." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there is NO dot between two cells, their difference CANNOT be 1 and their ratio CANNOT be 2:1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il n'y a AUCUN point entre deux cellules, leur différence ne peut PAS être 1 et leur rapport ne peut PAS être 2:1."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо між двома клітинками НЕМАЄ крапки, їхня різниця НЕ МОЖЕ дорівнювати 1, а співвідношення НЕ МОЖЕ бути 2:1."
          }
        }
      }
    },
