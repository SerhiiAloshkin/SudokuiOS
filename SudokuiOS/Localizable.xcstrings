    "Analyzes the board logically and provides a step-by-step deduction to help you progress. Has a 5-minute cooldown after each use, shown as a countdown on the button itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyzes the board logically and provides a step-by-step deduction to help you progress. Has a 5-minute cooldown after each use, shown as a countdown on the button itself."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse la grille logiquement et fournit une déduction étape par étape pour vous aider à progresser. Un délai de 5 minutes s'applique après chaque utilisation, affiché en compte à rebours sur le bouton."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логічно аналізує дошку та надає покрокову підказку для прогресу. Має 5-хвилинну затримку після кожного використання, яка показана як зворотний відлік на самій кнопці."
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appearance"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparence"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вигляд"
          }
        }
      }
    },
    "Appears only on Sandwich levels. Adds or removes notes for 1 and 9 across your selected empty cells, based on where each is currently a valid candidate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears only on Sandwich levels. Adds or removes notes for 1 and 9 across your selected empty cells, based on where each is currently a valid candidate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaît uniquement sur les niveaux Sandwich. Ajoute ou retire les notes 1 et 9 sur vos cellules vides sélectionnées, selon que chacune est actuellement un candidat valide."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З'являється лише на рівнях «Сандвіч». Додає або видаляє нотатки 1 і 9 у вибраних порожніх клітинках, залежно від того, де кожна з них наразі є дійсним кандидатом."
          }
        }
      }
    },
    "Applies background colors to cells. Essential for advanced logical techniques like 'Coloring'. Tap the circle-slash swatch to clear a cell's color." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies background colors to cells. Essential for advanced logical techniques like 'Coloring'. Tap the circle-slash swatch to clear a cell's color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique des couleurs de fond aux cellules. Essentiel pour des techniques logiques avancées comme le « coloriage ». Touchez la pastille barrée pour effacer la couleur d'une cellule."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовує кольори фону до клітинок. Необхідно для просунутих логічних технік, як-от «розфарбовування». Торкніться перекресленого кола, щоб прибрати колір клітинки."
          }
        }
      }
    },
    "Are you sure?" : {
