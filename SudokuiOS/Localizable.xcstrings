    "This mode highlights all valid positions for a number, which can make the game significantly easier. You might find the puzzles less challenging or lose interest more quickly. Do you still want to activate it?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mode highlights all valid positions for a number, which can make the game significantly easier. You might find the puzzles less challenging or lose interest more quickly. Do you still want to activate it?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mode met en surbrillance toutes les positions valides pour un chiffre, ce qui peut rendre le jeu beaucoup plus facile. Vous pourriez trouver les grilles moins stimulantes ou perdre plus vite l'intérêt. Voulez-vous quand même l'activer ?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей режим підсвічує всі дійсні позиції для числа, що може значно спростити гру. Головоломки можуть здатися менш складними, і ви можете швидше втратити інтерес. Ви все ще хочете його увімкнути?"
          }
        }
      }
    },
    "This will clear all your progress." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all your progress."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera toute votre progression."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить увесь ваш прогрес."
          }
        }
      }
    },
    "This will clear your time, notes, and progress on this level. Your best time is kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear your time, notes, and progress on this level. Your best time is kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera votre temps, vos notes et votre progression sur ce niveau. Votre meilleur temps est conservé."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить ваш час, нотатки та прогрес на цьому рівні. Ваш рекордний час буде збережено."
          }
        }
      }
    },
