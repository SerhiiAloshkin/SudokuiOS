    "Automatically erases candidate notes that are mathematically impossible within a cage or sandwich." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically erases candidate notes that are mathematically impossible within a cage or sandwich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface automatiquement les notes candidates mathématiquement impossibles dans une cage ou un sandwich."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично видаляє нотатки-кандидати, які математично неможливі в клітці чи «сандвічі»."
          }
        }
      }
    },
    "Automatically highlights every instance of your selected number across the entire board." : {
