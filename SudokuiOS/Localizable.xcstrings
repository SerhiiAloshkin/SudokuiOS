    "Swipe across the grid to select multiple cells. Your inputs will apply to all selected cells simultaneously." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe across the grid to select multiple cells. Your inputs will apply to all selected cells simultaneously."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez sur la grille pour sélectionner plusieurs cellules. Vos saisies s'appliqueront à toutes les cellules sélectionnées simultanément."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть пальцем по сітці, щоб вибрати кілька клітинок. Ваше введення застосується до всіх вибраних клітинок одночасно."
          }
        }
      }
    },
    "Switch between Light mode, Dark mode, or System (which follows your device appearance)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch between Light mode, Dark mode, or System (which follows your device appearance)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculez entre le mode Clair, le mode Sombre ou Système (qui suit l'apparence de votre appareil)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикайтеся між світлим режимом, темним режимом або системним (що відповідає вигляду пристрою)."
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
